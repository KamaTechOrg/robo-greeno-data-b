# Copy to .env and adjust for your environment.

# --- Robot identity ---
ROBOT_ID=spider-01

# --- Frame source ---
# webcam    = pull frames from a real camera via cv2.VideoCapture (bot default)
# synthetic = generated frames, no camera needed (off-bot build/artifact verification)
# folder    = sequential images from IMAGE_SOURCE_DIR (dev/eval parity with laptop workflow)
FRAME_SOURCE=webcam
CAMERA_INDEX=0
IMAGE_SOURCE_DIR=images

# --- MQTT (off-bot broker) ---
MQTT_ENABLED=1
MQTT_HOST=broker.internal
MQTT_PORT=1883
MQTT_TOPIC=MQTT/vision/detections

# --- Defect inference API (off-bot, optional) ---
DEFECT_SERVICE_URL=http://infer.internal:8011/infer_json

# --- MinIO (dev/comparison only) ---
# The bot is never a MinIO writer in production. Leave at 0 unless doing a laptop-side
# comparison run against the AgCloud dev stack.
MINIO_UPLOAD_ENABLED=0

# --- Model artifacts ---
# Baked into the image at build time from the local model_weights/ folder; MODEL_DIR
# points at where the Dockerfile placed them inside the container.
MODEL_DIR=/app/model_weights

# --- Storage ---
# Where per-run crop images are written; bind-mount this path (see docker-compose.yml)
# so processed images stay accessible on the host, matched to detections via crop_path/run_id.
STORAGE_DIR_OVERRIDE=/data/crops

# --- Container runtime user (must match the host UID/GID that owns ./crops) ---
APP_UID=1000
APP_GID=1000

LOG_LEVEL=INFO
